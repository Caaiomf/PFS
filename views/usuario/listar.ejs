<script scr="../js/usuario/listar"></script>
<div>
    <h1>Usuarios Cadastrados</h1>
    <div>
        <a class ="btn btn-primary" href="/usuario/cadastrar">
            <i class ="fas fa-plus">Cadastrar Usuario</i>
        </a>
    </div>
    <div>
        <!-- Montagem da tabela Dinamica-->
         <table>
            <thead class ="table table-striped">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Ativo</th>
                    <th>Perfil</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% for(let i = 0; i<usuarios.length; i++ ) { %>
                    <tr>
                        <td><%= usuarios[i].id %></td>
                        <td><%= usuarios[i].nome %></td>
                        <td><%= usuarios[i].email %></td>
                        <td><%= usuarios[i].ativo %></td>
                        <td><%= usuarios[i].perfilDescricao %></td>
                        <td>
                            <button class="btn btn-primary">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button data-idexclusao="<%= usuarios[i].id %>"class ="btnExclusao btn btn-danger">
                                <i class ="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                <% } %>
                <tr></tr>
            </tbody>
         </table>
    </div>
</div>